{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmux.local/schemas/ipc_messages.schema.json",
  "title": "agentmux IPC messages",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["id", "type", "payload"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "payload": { "type": "object" }
      }
    },
    "response": {
      "type": "object",
      "required": ["id", "ok"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "ok": { "type": "boolean" },
        "payload": { "type": "object" },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "event": {
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "payload": { "type": "object" }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "hint": { "type": "string" }
      }
    }
  }
}
